# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Large forcing datasets
forcing/WFDE5_CRU_GPCC/
forcing/WFDE5_CRU_GPCC_ecland/
forcing/WFDE5_CRU_GPCC_cds_raw/
*.nc
*.grb
*.grib
*.grb1
*.grb2
*.zarr/

# Generated ancillary files
init_clim/output/
init_clim/work/

# Externally copied Python dependency
init_clim/osm_pyutils/

# CaMa-Flood weight-derivation scratch space (default ./work/, plus
# resolution-tagged variants such as work_06min/, and
# build_global_cmf_fixdir.sh's own work_global*/ output/scratch dirs)
cama_flood/work/
cama_flood/work_*/
cama_flood/work_global/
cama_flood/work_global_scratch/

# ... except the validated, LIAISE-derived reference/observation files (Git
# LFS), which would otherwise be caught by the *.nc rule above.
!cama_flood/data/*.nc
!cama_flood/data_06min/*.nc
!cama_flood/data_03min/*.nc
!landbench/data/*/*.nc

# First-pass reservoir run staging (symlinks to cama_flood/data/ + a
# not-yet-GRSAD-calibrated dam_param.csv, see PLAN.md) -- CMF_STATIC_DIR for
# the dammed run, kept separate from the validated cama_flood/data/ on purpose.
cama_flood/data_dam_firstpass/

# Runtime products (bin_*/lib64_* variants are pinned executables for a
# specific test/bisect, e.g. run/bin_depthtrilogy/ -- same pattern as
# cama_flood/work_*/ above)
run/bin/
run/bin_*/
run/lib64/
run/lib64_*/
run/logs/
run/output/
run/output_*/
run/restart/
run/work/

# Scheduler output
slurm-*.out
*.out
*.err
*.log

# Temporary files
*.tmp
*.bak
*~
.DS_Store

# eclandpy bridge: same convention as run/output + run/restart above -- the
# 37-year land run's own output (35 GB), its pickled restart chain, the derived
# CaMa-Flood runoff/discharge, and the generated dashboard (published to
# sites.ecmwf.int/pad/liaise/eclandpy/, rebuilt by build_eclandpy_dashboard.py).
eclandpy_bridge/data/
eclandpy_bridge/output/
eclandpy_bridge/output_gpu/
eclandpy_bridge/restart/
eclandpy_bridge/restart_gpu/
eclandpy_bridge/cmfgpu_runoff/
eclandpy_bridge/cmfgpu_runoff_gpu/
eclandpy_bridge/cmfgpu_out/
eclandpy_bridge/cmfgpu_out_gpu*/
eclandpy_bridge/dashboard_eclandpy/
eclandpy_bridge/logs/
eclandpy_bridge/output_v2/
eclandpy_bridge/restart_v2/
eclandpy_bridge/cmfgpu_runoff_gpu*/
eclandpy_bridge/dashboard_eclandpy_v1/
eclandpy_bridge/dashboard_eclandpy_v2/
